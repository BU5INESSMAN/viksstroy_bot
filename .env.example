# ============================================================
# ⚙️ ОСНОВНЫЕ НАСТРОЙКИ СИСТЕМЫ "ВИКС РАСПИСАНИЕ"
# ============================================================

# Токен бота MAX
MAX_BOT_TOKEN=

# Путь к файлу базы данных SQLite (внутри контейнера или локально)
DB_PATH=

# Канонический адрес приложения. Используется во всех кнопках, приглашениях,
# уведомлениях и системных ссылках.
WEB_APP_URL=https://n.viksstroy.online
APP_VERSION=2.16.0
CORS_ORIGINS=https://n.viksstroy.online,https://miniapp.viks22.ru


# ============================================================
# 💬 НАСТРОЙКИ ГРУППЫ MAX
# ============================================================

# ID группы, куда публикуются наряды, расстановка и сообщения об обновлениях.
MAX_GROUP_CHAT_ID=


# ============================================================
# 🔐 ПАРОЛИ ДЛЯ РЕГИСТРАЦИИ ПОЛЬЗОВАТЕЛЕЙ
# ============================================================
# Эти пароли сотрудники вводят один раз при первом запуске бота

# Пароль для роли: Сотрудник
EMPLOYEE_PASS=

# Пароль для роли: 👷‍♂️ Прораб
FOREMAN_PASS=

# Пароль для роли: 🛡 Модератор
MODERATOR_PASS=

# Пароль для роли: 👔 БОСС
BOSS_PASS=

# Пароль для роли: 👑 Супер-Админ
SUPERADMIN_PASS=


# ============================================================
# 🔑 СЕКРЕТ ДЛЯ CRON-ЭНДПОИНТОВ (внутренние задачи по расписанию)
# ============================================================
# Общий секрет для защиты POST /api/cron/* (заголовок X-Cron-Secret).
# ОБЯЗАТЕЛЬНО задайте непустое значение: при пустом значении cron-эндпоинты
# ОТКЛЮЧЕНЫ (fail-closed, v2.7.1 M-2). Сгенерировать значение:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=


# ============================================================
# 🛡 ID РУКОВОДСТВА (ДЛЯ ПРЯМОГО ДОСТУПА И ЛОГОВ)
# ============================================================
# Укажите внутренний ID супер-администратора (для MAX используется отрицательный ID).
# Можно указать несколько ID через запятую без пробелов.

# Получают уведомления о действиях сотрудников + системные ошибки (Tracebacks)
SUPER_ADMIN_IDS=

# Внешняя проверка доступности. Используется серверным watchdog, который
# продолжает работать даже при остановке контейнера API.
WATCHDOG_HEALTH_URL=https://n.viksstroy.online/api/health
WATCHDOG_REMIND_SECONDS=3600

# Получают только уведомления о действиях (кто зашел, кто создал/одобрил заявку)
BOSS_IDS=
