RELEASE_VERSION="2.19.1"
RELEASE_SUMMARY="Исправлено заполнение часов СМР: общие часы необязательны при индивидуальном заполнении, а 0 считается допустимым значением"
RELEASE_NOTES=(
  "Общее поле часов бригады больше не требуется, если часы указаны участникам отдельно"
  "Нулевые часы сохраняются как явно введённое корректное значение"
  "Изменение общего поля не удаляет индивидуальные часы и введённую ЗП"
)
