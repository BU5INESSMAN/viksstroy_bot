RELEASE_VERSION="2.19.5"
RELEASE_SUMMARY="Импорт справочника СМР использует только D, E, G, H и не зависит от внутренних расчётных колонок"
RELEASE_NOTES=(
  "D используется как название работы, E как цена СМР, G как единица измерения, H как расценка ЗП"
  "A-C, F и столбцы после H больше не влияют на импорт"
  "Заголовок листа определяется автоматически, даже если он сдвинут по строкам"
  "Неудачные попытки загрузки записываются в журнал с точной причиной"
)
