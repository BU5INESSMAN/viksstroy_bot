RELEASE_VERSION="2.19.4"
RELEASE_SUMMARY="Excel объединённого СМР раздельно показывает объекты, заявки, сотрудников и работы"
RELEASE_NOTES=(
  "В объединённом Excel появился отдельный лист со всеми объектами и номерами заявок"
  "На листе часов для каждого сотрудника указан его объект"
  "Основные и дополнительные работы подписаны объектом и заявкой"
  "Неоднозначные старые строки показывают все возможные объекты без подмены данных"
)
