RELEASE_VERSION="2.20.1"
RELEASE_SUMMARY="Объединённый СМР разделён по исходным объектам: сотрудники, часы, ЗП, основные и дополнительные работы больше не объединяются через слеш и сохраняются в соответствующие заявки"
RELEASE_NOTES=(
  "Каждый объект в объединённом СМР отображается отдельным блоком"
  "Сотрудники, часы и ЗП сохраняются отдельно для каждой исходной заявки"
  "Основные и дополнительные работы больше не объединяются между объектами через слеш"
  "Повторное открытие, редактирование, допотчёты, Excel и хронология сохраняют раздельную привязку"
)
