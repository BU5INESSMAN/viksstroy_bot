RELEASE_VERSION="2.23.3"
RELEASE_SUMMARY="Исправлены состав работников и сохранение нулевых часов в СМР"
RELEASE_NOTES=(
  "Добавленные работники сохраняются при переходах между шагами и восстановлении черновика"
  "Нулевые часы сохраняются при массовом вводе и очистке предложения ЗП"
  "Проверка учитывает изменение состава заявки и объясняет причину незаполненного СМР"
)
