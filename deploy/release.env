RELEASE_VERSION="2.15.5"
RELEASE_NOTES=(
  "Мобильный запуск теперь требует один основной JavaScript-файл вместо шести"
  "Форма входа открывается без дополнительных пакетов, остальные разделы загружаются после запуска"
  "Экран сбоя показывает, какой файл интерфейса не удалось загрузить"
  "Проверочный домен m.viksstroy.online работает через прокси Cloudflare"
)
