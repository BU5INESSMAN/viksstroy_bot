RELEASE_VERSION="2.22.0"
RELEASE_SUMMARY="📊 Большой журнал действий, ошибок и неудобств интерфейса; 📈 Полный отчёт СМР за период на трёх листах, включая архив; 👥 Аудит и безопасное объединение карточек сотрудников; 🗄 Массовая архивация учтённых СМР без разделения объединённых отчётов"
RELEASE_NOTES=(
  "📊 Супер-админ видит действия, ошибки, медленные операции и признаки неудобного интерфейса"
  "📱 Журнал фиксирует повторные нажатия, незавершённые формы и модальные окна, не помещающиеся на экран"
  "🔒 Пароли, токены, коды и значения полей не записываются"
  "📥 Доступны анализ за 2, 7 или 30 дней, поиск, рекомендации и выгрузка CSV"
  "📈 Отчёт СМР за период содержит сводку, строки по заявкам и полный список работ"
  "🗄 Архивные СМР всегда входят в отчёт по дате выполнения; неучтённые подключаются отдельной галочкой"
  "👥 Добавлен безопасный аудит дублей и исторических карточек сотрудников без потери старых часов"
  "✅ Учтённые СМР можно массово архивировать; объединённые отчёты обрабатываются целиком"
)
