RELEASE_VERSION="2.20.2"
RELEASE_SUMMARY="Отчёты СМР скачиваются отдельными XLSX по каждой бригаде через новое окно файлов; Кадры и бухгалтерия по умолчанию видят только полностью заполненные СМР, неполные доступны отдельным фильтром; освобождённые бригады и техника снова доступны для новой заявки; проблемы на главной сгруппированы по типам, а интерфейс очищен от старых ошибок линтера"
RELEASE_NOTES=(
  "Для каждой бригады формируется отдельный XLSX без ZIP-архива"
  "В карточке СМР доступны общая информация, отдельные файлы и кнопка скачивания всех файлов"
  "Неполные отчёты скрыты от Кадров и бухгалтерии по умолчанию и не могут быть учтены"
  "Освобождённые ресурсы корректно доступны в следующей заявке, а проблемы на главной сгруппированы"
)
